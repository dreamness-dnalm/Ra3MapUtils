<UserControl x:Class="UI.Views.Pages.SettingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingPageViewModel}"
             Background="Transparent"
             FontFamily="Segoe UI Variable Text, Segoe UI">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="28,20,28,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0"
                 Text="{Binding PageTitle}"
                 FontSize="28"
                 FontWeight="SemiBold"
                 Margin="0,0,0,4" />

      <TextBlock Grid.Row="1"
                 Text="{Binding PageSubtitle}"
                 Opacity="0.65"
                 FontSize="12"
                 Margin="0,0,0,20" />

      <Border Grid.Row="2"
              Padding="16"
              CornerRadius="8"
              BorderBrush="#22000000"
              BorderThickness="1"
              Background="#08FFFFFF"
              Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <TextBlock Text="{Binding LanguageLabel}" FontWeight="SemiBold" FontSize="14" />
            <TextBlock Text="{Binding LanguageHint}"
                       Margin="0,6,0,0"
                       Opacity="0.65"
                       FontSize="12"
                       TextWrapping="Wrap" />
          </StackPanel>
          <ComboBox Grid.Column="1"
                    Width="180"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding LanguageOptions}"
                    SelectedValuePath="Code"
                    DisplayMemberPath="DisplayName"
                    SelectedValue="{Binding SelectedLanguageCode, Mode=TwoWay}" />
        </Grid>
      </Border>

      <Border Grid.Row="3"
              Padding="16"
              CornerRadius="8"
              BorderBrush="#22000000"
              BorderThickness="1"
              Background="#08FFFFFF"
              Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="{Binding UpdateSectionTitle}"
                     FontWeight="SemiBold"
                     FontSize="14"
                     Margin="0,0,0,6" />
          <TextBlock Text="{Binding UpdateChannelHint}"
                     Opacity="0.65"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Margin="0,0,0,12" />
          <TextBlock Margin="0,0,0,8">
            <Run Text="{Binding UpdateVersionLabel}" />
            <Run Text=" " />
            <Run Text="{Binding CurrentVersionText}" FontWeight="SemiBold" />
          </TextBlock>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="{Binding CheckUpdateLabel}"
                    Padding="12,6"
                    Margin="0,0,8,0"
                    Command="{Binding CheckForUpdateCommand}" />
            <Button Content="{Binding DownloadUpdateLabel}"
                    Padding="12,6"
                    Margin="0,0,8,0"
                    Command="{Binding DownloadAndStageCommand}"
                    IsEnabled="{Binding CanDownloadUpdate}" />
            <Button Content="{Binding ApplyUpdateLabel}"
                    Padding="12,6"
                    Command="{Binding ApplyAndExitCommand}"
                    IsEnabled="{Binding CanApplyUpdate}" />
          </StackPanel>
          <ProgressBar Height="6"
                       Margin="0,0,0,8"
                       Minimum="0"
                       Maximum="1"
                       Value="{Binding UpdateProgressRatio}">
            <ProgressBar.Style>
              <Style TargetType="ProgressBar">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsUpdateProgressVisible}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ProgressBar.Style>
          </ProgressBar>
          <TextBlock Text="{Binding UpdateStatusText}"
                     TextWrapping="Wrap"
                     Opacity="0.8" />
        </StackPanel>
      </Border>

      <Border Grid.Row="4"
              Padding="16"
              CornerRadius="8"
              BorderBrush="#22000000"
              BorderThickness="1"
              Background="#08FFFFFF">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0"
                     Text="{Binding LuaSectionTitle}"
                     FontWeight="SemiBold"
                     FontSize="14"
                     Margin="0,0,0,6" />
          <TextBlock Grid.Row="1"
                     Text="{Binding RedundancyHint}"
                     Opacity="0.65"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Margin="0,0,0,12" />
          <DockPanel Grid.Row="2">
            <Button DockPanel.Dock="Right"
                    Content="{Binding RedundancyApplyLabel}"
                    Padding="14,6"
                    Margin="12,0,0,0"
                    Command="{Binding ApplyRedundancyFactorCommand}" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{Binding RedundancyLabel}"
                         VerticalAlignment="Center"
                         Margin="0,0,12,0" />
              <TextBox Width="100"
                       Text="{Binding RedundancyFactorText, UpdateSourceTrigger=PropertyChanged}"
                       VerticalContentAlignment="Center"
                       Padding="6,4" />
              <TextBlock Text="{Binding RedundancyStatus}"
                         Margin="12,0,0,0"
                         Opacity="0.7"
                         VerticalAlignment="Center" />
            </StackPanel>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
