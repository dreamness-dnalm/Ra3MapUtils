<Page x:Class="Ra3MapUtils.Views.MainWindowPages.ToolBoxPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Ra3MapUtils.Views.MainWindowPages"
      xmlns:vm="clr-namespace:Ra3MapUtils.ViewModels.MainWindowPages"
      d:DataContext="{d:DesignInstance Type=vm:ToolBoxPageViewModel, IsDesignTimeCreatable=True}"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      d:DesignHeight="1650"
      d:DesignWidth="1000"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d"
      Title="ToolBoxPage"  VerticalAlignment="Top" HorizontalAlignment="Stretch" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        
        
        
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch"
                      Margin="10, 10, 10, 10">
            <WrapPanel Orientation="Horizontal">
                <ui:CardAction
                    Margin="4,4,4,4"
                    Padding="0"
                    VerticalAlignment="Stretch"
                    Command="{Binding OpenLogViewerWindowCommand}"
                    IsChevronVisible="False" Visibility="Visible">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image
                            Width="60"
                            Margin="24,0,0,0"
                            Source="pack://application:,,,/data/imgs/log_viewer_icon.png" />

                        <StackPanel
                            Grid.Column="1"
                            Margin="24"
                            VerticalAlignment="Center">
                            <ui:TextBlock
                                Margin="0"
                                FontTypography="BodyStrong"
                                Text="地图日志查看器"
                                TextWrapping="WrapWithOverflow" />
                            <ui:TextBlock
                                Appearance="Secondary"
                                Text="查看Lua库产生的日志"
                                TextWrapping="WrapWithOverflow" />
                        </StackPanel>
                    </Grid>
                </ui:CardAction>
                <ui:CardAction
                    Margin="4,4,4,4"
                    Padding="0"
                    VerticalAlignment="Stretch"
                    Command="{Binding OpenNewWorldBuilderDebugProgramCommand}"
                    IsChevronVisible="False"
                    Visibility="Visible">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image
                            Width="60"
                            Margin="24,0,0,0"
                            Source="pack://application:,,,/data/imgs/new_world_builder_debug_icon.png" />

                        <StackPanel
                            Grid.Column="1"
                            Margin="24"
                            VerticalAlignment="Center">
                            <ui:TextBlock
                                Margin="0"
                                FontTypography="BodyStrong"
                                Text="打开调试工具"
                                TextWrapping="WrapWithOverflow" />
                            <ui:TextBlock
                                Appearance="Secondary"
                                Text="全新调试工具"
                                TextWrapping="WrapWithOverflow" />
                        </StackPanel>
                    </Grid>
                </ui:CardAction>
                <ui:CardAction
                    Margin="4,4,4,4"
                    Padding="0"
                    VerticalAlignment="Stretch"
                    Command="{Binding OpenChatLuaHelperWindowCommand}"
                    IsChevronVisible="False" Visibility="Visible">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image
                            Width="60"
                            Margin="24,0,0,0"
                            Source="pack://application:,,,/data/imgs/chat_lua_helper_icon.png" />

                        <StackPanel
                            Grid.Column="1"
                            Margin="24"
                            VerticalAlignment="Center">
                            <ui:TextBlock
                                Margin="0"
                                FontTypography="BodyStrong"
                                Text="地图聊天框Lua拆分工具"
                                TextWrapping="WrapWithOverflow" />
                            <ui:TextBlock
                                Appearance="Secondary"
                                Text="针对Lua库中的ChatLuaHelper"
                                TextWrapping="WrapWithOverflow" />
                        </StackPanel>
                    </Grid>
                </ui:CardAction>
                
                <ui:CardAction
                    Margin="4,4,4,4"
                    Padding="0"
                    VerticalAlignment="Stretch"
                    IsChevronVisible="False" Visibility="Visible">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel
                            Grid.Column="0"
                            Margin="24"
                            VerticalAlignment="Center">
                            <ui:TextBlock
                                Margin="0"
                                FontTypography="BodyStrong"
                                Text="窗口置顶-日冕mod"
                                TextWrapping="WrapWithOverflow" />
                            <ui:ToggleSwitch OnContent="已置顶" OffContent="未置顶" IsChecked="{Binding IsRa3CoronaTopmost}"/>
                        </StackPanel>
                    </Grid>
                </ui:CardAction>
                
                <ui:CardAction
                    Margin="4,4,4,4"
                    Padding="0"
                    VerticalAlignment="Stretch"
                    IsChevronVisible="False" Visibility="Visible">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel
                            Grid.Column="0"
                            Margin="24"
                            VerticalAlignment="Center">
                            <ui:TextBlock
                                Margin="0"
                                FontTypography="BodyStrong"
                                Text="窗口置顶-新地编"
                                TextWrapping="WrapWithOverflow" />
                            <ui:ToggleSwitch OnContent="已置顶" OffContent="未置顶" IsChecked="{Binding IsNewWorldBuilderTopmost}"/>
                        </StackPanel>
                    </Grid>
                </ui:CardAction>
                
                <ui:CardAction
                    Margin="4,4,4,4"
                    Padding="0"
                    VerticalAlignment="Stretch"
                    Command="{Binding OpenMapDataEditorWindowCommand}"
                    IsChevronVisible="False"
                    Visibility="Visible">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image
                            Width="60"
                            Margin="24,0,0,0"
                            Source="pack://application:,,,/data/imgs/map_data_editor_icon.png" />

                        <StackPanel
                            Grid.Column="1"
                            Margin="24"
                            VerticalAlignment="Center">
                            <ui:TextBlock
                                Margin="0"
                                FontTypography="BodyStrong"
                                Text="地图数据编辑器"
                                TextWrapping="WrapWithOverflow" />
                            <ui:TextBlock
                                Appearance="Secondary"
                                Text="解析地图数据"
                                TextWrapping="WrapWithOverflow" />
                        </StackPanel>
                    </Grid>
                </ui:CardAction>

                <ui:CardAction
                    Margin="4,4,4,4"
                    Padding="0"
                    VerticalAlignment="Stretch"
                    Command="{Binding OpenImageEncodingToolWindowCommand}"
                    IsChevronVisible="False"
                    Visibility="Visible">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image
                            Width="60"
                            Margin="24,0,0,0"
                            Source="pack://application:,,,/data/imgs/image_encoding_tool_icon.png" />

                        <StackPanel
                            Grid.Column="1"
                            Margin="24"
                            VerticalAlignment="Center">
                            <ui:TextBlock
                                Margin="0"
                                FontTypography="BodyStrong"
                                Text="图片编码工具"
                                TextWrapping="WrapWithOverflow" />
                            <ui:TextBlock
                                Appearance="Secondary"
                                Text="图片转JPG/PNG/WEBP Base64和Lua片段"
                                TextWrapping="WrapWithOverflow" />
                        </StackPanel>
                    </Grid>
                </ui:CardAction>

                <ui:CardAction
                    Margin="4,4,4,4"
                    Padding="0"
                    VerticalAlignment="Stretch"
                    Command="{Binding OpenFastHashCalculatorWindowCommand}"
                    IsChevronVisible="False"
                    Visibility="Visible">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image
                            Width="60"
                            Margin="24,0,0,0"
                            Source="pack://application:,,,/data/imgs/fast_hash_calculator_icon.png" />

                        <StackPanel
                            Grid.Column="1"
                            Margin="24"
                            VerticalAlignment="Center">
                            <ui:TextBlock
                                Margin="0"
                                FontTypography="BodyStrong"
                                Text="FastHash计算器"
                                TextWrapping="WrapWithOverflow" />
                            <ui:TextBlock
                                Appearance="Secondary"
                                Text="传说中的增援代码"
                                TextWrapping="WrapWithOverflow" />
                        </StackPanel>
                    </Grid>
                </ui:CardAction>

                <ui:CardAction
                    Margin="4,4,4,4"
                    Padding="0"
                    VerticalAlignment="Stretch"
                    Command="{Binding OpenLuaExecutorWindowCommand}"
                    IsChevronVisible="False"
                    Visibility="Visible">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image
                            Width="60"
                            Margin="24,0,0,0"
                            Source="pack://application:,,,/data/imgs/lua_executor_icon.png" />

                        <StackPanel
                            Grid.Column="1"
                            Margin="24"
                            VerticalAlignment="Center">
                            <ui:TextBlock
                                Margin="0"
                                FontTypography="BodyStrong"
                                Text="Lua执行器"
                                TextWrapping="WrapWithOverflow" />
                            <ui:TextBlock
                                Appearance="Secondary"
                                Text="在地图lua环境中运行Lua"
                                TextWrapping="WrapWithOverflow" />
                        </StackPanel>
                    </Grid>
                </ui:CardAction>

                <ui:CardAction
                    Margin="4,4,4,4"
                    Padding="0"
                    VerticalAlignment="Stretch"
                    Command="{Binding OpenTimeControlWindowCommand}"
                    IsChevronVisible="False"
                    Visibility="Visible">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image
                            Width="60"
                            Margin="24,0,0,0"
                            Source="pack://application:,,,/data/imgs/time_control_icon.png" />

                        <StackPanel
                            Grid.Column="1"
                            Margin="24"
                            VerticalAlignment="Center">
                            <ui:TextBlock
                                Margin="0"
                                FontTypography="BodyStrong"
                                Text="时间操控"
                                TextWrapping="WrapWithOverflow" />
                            <ui:TextBlock
                                Appearance="Secondary"
                                Text="修改游戏内时间"
                                TextWrapping="WrapWithOverflow" />
                        </StackPanel>
                    </Grid>
                </ui:CardAction>

                <ui:CardAction
                    Margin="4,4,4,4"
                    Padding="0"
                    VerticalAlignment="Stretch"
                    Command="{Binding OpenMoreFunctionsWindowCommand}"
                    IsChevronVisible="False">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image
                            Width="60"
                            Margin="24,0,0,0"
                            Source="pack://application:,,,/data/imgs/coming_soon_icon.png" />

                        <StackPanel
                            Grid.Column="1"
                            Margin="24"
                            VerticalAlignment="Center">
                            <ui:TextBlock
                                Margin="0"
                                FontTypography="BodyStrong"
                                Text="更多功能敬请期待"
                                TextWrapping="WrapWithOverflow" />
                            <ui:TextBlock
                                Appearance="Secondary"
                                Text="欢迎联系, 期待您的需求和建议"
                                TextWrapping="WrapWithOverflow" />
                        </StackPanel>
                    </Grid>
                </ui:CardAction>
            </WrapPanel>
        </ScrollViewer>
        
    </Grid>
</Page>
