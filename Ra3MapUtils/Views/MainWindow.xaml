<ui:FluentWindow x:Class="Ra3MapUtils.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ra3MapUtils"
        xmlns:vm="clr-namespace:Ra3MapUtils.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel, IsDesignTimeCreatable=True}"
        xmlns:mainWindowPages="clr-namespace:Ra3MapUtils.Views.MainWindowPages"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        d:DesignHeight="650"
        d:DesignWidth="800"
        ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
        ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="741" Width="1200"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        Closing="MainWindow_OnClosing"
        >
    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger EventName="Closing" >
            <behaviors:InvokeCommandAction Command="{Binding CloseWindowCommand }"  PassEventArgsToCommand="False"/>
        </behaviors:EventTrigger>
    </behaviors:Interaction.Triggers>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{Binding WindowTitle}" ShowMaximize="True">
            
        </ui:TitleBar>
        <hc:NotifyIcon Text="{Binding WindowTitle}" IsBlink="False" Visibility="Visible" Icon="pack://application:,,,/data/imgs/icon.png">
            <hc:NotifyIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{Binding WindowTitle}"/>
                    <MenuItem Header="显示" Command="{Binding ShowWindowCommand}"/>
                    <MenuItem Header="退出" Command="{Binding ExitCommand}"/>
                </ContextMenu>
            </hc:NotifyIcon.ContextMenu>
        </hc:NotifyIcon>
        <ui:NavigationView Grid.Row="1"
            x:Name="MainNavigationView"
               VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Height="Auto"
                Margin="0"
                IsBackButtonVisible="Auto"
                IsPaneToggleVisible="True"
                PaneDisplayMode="Left"
            OpenPaneLength="200"
                PaneTitle=""  IsPaneOpen="False">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem
                        Content="首页"
                        TargetPageTag="HomePage"
                        TargetPageType="{x:Type mainWindowPages:HomePage}"
                        >
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Home24" Foreground="OrangeRed"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem
                        Content="地图"
                        TargetPageTag="MapManagePage"
                        TargetPageType="{x:Type mainWindowPages:MapManagePage}"
                        >
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Map20" Foreground="Green"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem
                        Content="工具箱"
                        TargetPageTag="ToolBoxPage"
                        TargetPageType="{x:Type mainWindowPages:ToolBoxPage}"
                    >
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Briefcase20" Foreground="BlueViolet"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem
                        Content="大模型"
                        TargetPageTag="AIPage"
                        TargetPageType="{x:Type mainWindowPages:AIPage}"
                    >
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="BrainCircuit20" Foreground="DeepPink"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <!-- <ui:NavigationViewItem -->
                    <!--     Content="C#脚本" -->
                    <!--     TargetPageTag="ScriptListPage" -->
                    <!--     TargetPageType="{x:Type mainWindowPages:ScriptListPage}" -->
                    <!-- > -->
                    <!--     <ui:NavigationViewItem.Icon> -->
                    <!--         <ui:SymbolIcon Symbol="WindowConsole20" Foreground="DeepPink"/> -->
                    <!--     </ui:NavigationViewItem.Icon> -->
                    <!-- </ui:NavigationViewItem> -->
                    <!-- <ui:NavigationViewItem -->
                    <!--     Content="知识库" -->
                    <!--     Icon="{ui:SymbolIcon Library20}" -->
                    <!--     TargetPageTag="ToolBoxPage" -->
                    <!--     TargetPageType="{x:Type mainWindowPages:KnowledgeBasePage}" -->
                    <!-- /> -->
            
                </ui:NavigationView.MenuItems>
            
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    Content="设置"
                    Icon="{ui:SymbolIcon Settings24}"
                    TargetPageTag="SettingPage"
                    TargetPageType="{x:Type mainWindowPages:SettingPage}"
                >
                    <ui:NavigationViewItem.InfoBadge>
                        <ui:InfoBadge Severity="Critical" Visibility="{Binding SettingPageInfoBadgeVisibility}"/>
                    </ui:NavigationViewItem.InfoBadge>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem
                    Content="关于"
                    TargetPageTag="AboutPage"
                    TargetPageType="{x:Type mainWindowPages:AboutPage}"
                >
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Info12" Foreground="Green"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>

            </ui:NavigationView>
    </Grid>
 
        
</ui:FluentWindow>
