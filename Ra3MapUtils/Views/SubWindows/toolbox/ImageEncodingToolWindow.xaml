<ui:FluentWindow x:Class="Ra3MapUtils.Views.SubWindows.toolbox.ImageEncodingToolWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:Ra3MapUtils.ViewModels.toolbox"
                 xmlns:xamlConverters="clr-namespace:Ra3MapUtils.Utils.XamlConverters"
                 xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
                 d:DataContext="{d:DesignInstance Type=vm:ImageEncodingToolWindowViewModel, IsDesignTimeCreatable=True}"
                 d:DesignHeight="820"
                 d:DesignWidth="1080"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 mc:Ignorable="d"
                 Title="图片编码工具"
                 Height="820"
                 Width="1080"
                 MinHeight="640"
                 MinWidth="860"
                 ResizeMode="CanResizeWithGrip"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStyle="SingleBorderWindow"
                 Topmost="{Binding IsTopmost}"
                 AllowDrop="True"
                 PreviewDragOver="RootWindow_OnDragOver"
                 PreviewDrop="RootWindow_OnDrop"
                 DragOver="RootWindow_OnDragOver"
                 Drop="RootWindow_OnDrop">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <xamlConverters:BooleanToOppositeVisibilityConverter x:Key="BooleanToOppositeVisibilityConverter"/>
    </ui:FluentWindow.Resources>

    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger EventName="Closed">
            <behaviors:InvokeCommandAction Command="{Binding ClosedCommand}" PassEventArgsToCommand="False"/>
        </behaviors:EventTrigger>
    </behaviors:Interaction.Triggers>

    <Grid Margin="10,0,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ui:ToggleSwitch Grid.Column="0" Margin="0,6,12,0" Content="置顶" IsChecked="{Binding IsTopmost}"/>
            <ui:TitleBar Grid.Column="1" Title="图片编码工具" ShowMaximize="True" ShowMinimize="True" ShowClose="True"/>
        </Grid>

        <Grid Grid.Row="1" Margin="5,4,5,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ui:Button Grid.Column="0"
                       Content="打开图片"
                       Icon="{ui:SymbolIcon Document16}"
                       Command="{Binding OpenImageCommand}"
                       Margin="0,0,12,0"/>
            <TextBlock Grid.Column="1"
                       Text="输出格式:"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"/>
            <ComboBox Grid.Column="2"
                      Width="78"
                      ItemsSource="{Binding OutputFormats}"
                      SelectedItem="{Binding OutputFormat, Mode=TwoWay}"
                      Margin="0,0,12,0"/>
            <TextBlock Grid.Column="3"
                       Text="{Binding CompressionRatio, StringFormat=压缩比率: {0:0}%}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <Slider Grid.Column="4"
                    Width="150"
                    Minimum="0"
                    Maximum="95"
                    TickFrequency="5"
                    IsSnapToTickEnabled="True"
                    Value="{Binding CompressionRatio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0"/>
            <ui:Button Grid.Column="5"
                       Content="下载图片"
                       Icon="{ui:SymbolIcon Save20}"
                       Command="{Binding SaveOutputImageCommand}"
                       IsEnabled="{Binding HasImage}"
                       Margin="0,0,12,0"/>
            <TextBlock Grid.Column="6"
                       Text="{Binding FileName}"
                       ToolTip="{Binding FilePath}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>

        <Border Grid.Row="2"
                Margin="5,4,5,4"
                Padding="10,8"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="尺寸: " FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ImageSizeText}" Margin="0,0,18,0"/>
                <TextBlock Text="磁盘占用: " FontWeight="SemiBold"/>
                <TextBlock Text="{Binding DiskSizeText}" Margin="0,0,18,0"/>
                <TextBlock Text="{Binding OutputSizeLabel}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding OutputImageSizeText}" Margin="0,0,18,0"/>
                <TextBlock Text="Base64占用: " FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Base64SizeText}"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="3"
                Margin="5,4,5,4"
                Padding="10,8"
                BorderBrush="{Binding Base64WarningBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding HasBase64Warning, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding Base64WarningText}"
                       Foreground="{Binding Base64WarningBrush}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="4" Margin="5,6,5,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid Margin="10" Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="原图" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Border Grid.Row="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="0,0,0,10">
                            <Image Source="{Binding OriginalPreviewImage}" Stretch="Uniform" Margin="8"/>
                        </Border>

                        <TextBlock Grid.Row="2" Text="{Binding OutputFormat, StringFormat=输出图 ({0})}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Border Grid.Row="3"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Image Source="{Binding OutputPreviewImage}" Stretch="Uniform" Margin="8"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="拖入图片，或点击打开图片"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="16"
                               Visibility="{Binding HasImage, Converter={StaticResource BooleanToOppositeVisibilityConverter}}"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Background="{DynamicResource CardStrokeColorDefaultBrush}"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="转换后图片 Base64" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <ui:Button Grid.Column="1"
                               Content="复制"
                               Icon="{ui:SymbolIcon Copy20}"
                               Command="{Binding CopyCommand}"
                               CommandParameter="{Binding Base64Text}"
                               IsEnabled="{Binding HasImage}"/>
                </Grid>

                <TextBox Grid.Row="1"
                         Text="{Binding Base64Text, Mode=OneWay}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>

                <Grid Grid.Row="2" Margin="0,12,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Lua 片段" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ui:ToggleSwitch Grid.Column="1"
                                     Content="Base64换行"
                                     IsChecked="{Binding IsLuaBase64AutoWrap, Mode=TwoWay}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="2"
                               Text="每行长度:"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <ui:NumberBox Grid.Column="3"
                                  Width="120"
                                  MinWidth="120"
                                  Minimum="1"
                                  Maximum="4096"
                                  MaxDecimalPlaces="0"
                                  Value="{Binding LuaBase64LineLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding IsLuaBase64AutoWrap}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"/>
                    <ui:Button Grid.Column="5"
                               Content="复制"
                               Icon="{ui:SymbolIcon Copy20}"
                               Command="{Binding CopyCommand}"
                               CommandParameter="{Binding LuaText}"
                               IsEnabled="{Binding HasImage}"/>
                </Grid>

                <TextBox Grid.Row="3"
                         Text="{Binding LuaText, Mode=OneWay}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
