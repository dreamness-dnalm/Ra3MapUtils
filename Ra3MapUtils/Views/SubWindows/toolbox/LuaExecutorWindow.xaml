<ui:FluentWindow x:Class="Ra3MapUtils.Views.SubWindows.toolbox.LuaExecutorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
                 xmlns:vm="clr-namespace:Ra3MapUtils.ViewModels.toolbox"
                 d:DataContext="{d:DesignInstance Type=vm:LuaExecutorWindowViewModel, IsDesignTimeCreatable=True}"
                 d:DesignHeight="720"
                 d:DesignWidth="980"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 mc:Ignorable="d"
                 Title="Lua执行器"
                 Height="780"
                 Width="980"
                 MinHeight="680"
                 MinWidth="820"
                 ResizeMode="CanResizeWithGrip"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStyle="SingleBorderWindow"
                 Topmost="{Binding IsTopmost}">

    <Grid Margin="10,0,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ui:ToggleSwitch Grid.Column="0" Margin="0,6,12,0" Content="置顶" IsChecked="{Binding IsTopmost}"/>
            <ui:TitleBar Grid.Column="1" Title="Lua执行器" ShowMaximize="True" ShowMinimize="True" ShowClose="True"/>
        </Grid>

        <TabControl Grid.Row="1" Margin="5,4,5,8">
            <TabItem Header="运行下面的代码">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Margin="0,0,0,8"
                            Padding="12,10"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="环境" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="地图lua" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ui:Button Grid.Column="2"
                                           Content="运行代码"
                                           Icon="{ui:SymbolIcon Play16}"
                                           Command="{Binding RunCodeCommand}"/>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="补全" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <ui:ToggleSwitch Grid.Column="1"
                                                 Content="Lua库"
                                                 IsChecked="{Binding EnableLuaLibrary}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,16,0"/>
                                <TextBlock Grid.Column="2" Text="用户代码库" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="3"
                                         Text="{Binding UserCodeLibraryPath}"
                                         IsReadOnly="True"
                                         MinWidth="160"
                                         VerticalContentAlignment="Center"
                                         Margin="0,0,8,0"/>
                                <ui:Button Grid.Column="4"
                                           Icon="{ui:SymbolIcon FolderOpen16}"
                                           Command="{Binding BrowseUserCodeLibraryCommand}"
                                           ToolTip="选择用户 Lua 4 代码库"
                                           Margin="0,0,8,0"/>
                                <ui:Button Grid.Column="5"
                                           Icon="{ui:SymbolIcon Delete16}"
                                           Command="{Binding ClearUserCodeLibraryCommand}"
                                           ToolTip="清除用户代码库"
                                           Margin="0,0,8,0"/>
                                <ui:Button Grid.Column="6"
                                           Icon="{ui:SymbolIcon ArrowSync16}"
                                           Command="{Binding RefreshCompletionCommand}"
                                           ToolTip="重建 Lua 4 补全索引"/>
                            </Grid>

                            <TextBlock Grid.Row="2"
                                       Text="{Binding CompletionStatusText}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="3"
                                       Text="{Binding StatusText}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            ClipToBounds="True">
                        <avalonEdit:TextEditor x:Name="CodeEditor"
                                               FontFamily="Consolas"
                                               FontSize="13"
                                               ShowLineNumbers="True"
                                               HorizontalScrollBarVisibility="Auto"
                                               VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="运行文件">
                <Grid Margin="0,8,0,0">
                    <Border VerticalAlignment="Top"
                            Padding="16,14"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="环境" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="地图lua" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Grid.Row="1"
                                       Text="选择要执行的 Lua 文件"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>
                            <Grid Grid.Row="2" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding LuaFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"
                                         Margin="0,0,8,0"/>
                                <ui:Button Grid.Column="1"
                                           Content="选择文件"
                                           Icon="{ui:SymbolIcon FolderOpen16}"
                                           Command="{Binding BrowseLuaFileCommand}"
                                           Margin="0,0,8,0"/>
                                <ui:Button Grid.Column="2"
                                           Content="运行文件"
                                           Icon="{ui:SymbolIcon Play16}"
                                           Command="{Binding RunFileCommand}"/>
                            </Grid>
                            <TextBlock Grid.Row="3"
                                       Text="{Binding StatusText}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="5,0,5,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="输出" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox Text="{Binding OutputText, Mode=OneWay}"
                         Grid.Row="1"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Background="{DynamicResource CardStrokeColorDefaultBrush}"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="返回值" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox Text="{Binding ReturnsText, Mode=OneWay}"
                         Grid.Row="1"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>
            </Grid>

            <GridSplitter Grid.Column="3"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Background="{DynamicResource CardStrokeColorDefaultBrush}"/>

            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="响应" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox Text="{Binding ResponseText, Mode=OneWay}"
                         Grid.Row="1"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
