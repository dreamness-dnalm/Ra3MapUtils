<ui:FluentWindow x:Class="Ra3MapUtils.Views.SubWindows.toolbox.DebuggerMapSettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:Ra3MapUtils.ViewModels.toolbox"
                 d:DataContext="{d:DesignInstance Type=vm:DebuggerMapSettingsWindowViewModel, IsDesignTimeCreatable=False}"
                 d:DesignHeight="430"
                 d:DesignWidth="820"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 mc:Ignorable="d"
                 Title="重设游戏地图路径"
                 Height="430"
                 Width="820"
                 MinHeight="400"
                 MinWidth="700"
                 ResizeMode="CanResizeWithGrip"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStyle="SingleBorderWindow"
                 Topmost="{Binding IsTopmost}">

    <Grid Margin="10,0,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:ToggleSwitch Grid.Column="0" Margin="0,6,12,0" Content="置顶" IsChecked="{Binding IsTopmost}"/>
            <ui:TitleBar Grid.Column="1" Title="重设游戏地图路径" ShowMaximize="True" ShowMinimize="True" ShowClose="True"/>
        </Grid>

        <ui:InfoBar Grid.Row="1"
                    Margin="5,4,5,10"
                    Title="需要重新启动调试器"
                    Message="配置仅在调试器启动时读取。若调试器正在运行，请先关闭旧实例，再保存并重新启动。"
                    Severity="Warning"
                    IsOpen="True"/>

        <Border Grid.Row="2"
                Margin="5,0,5,10"
                Padding="16,14"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="游戏加载地图目录"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding MapFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"
                             Margin="0,0,8,0"/>
                    <ui:Button Grid.Column="1"
                               Content="选择目录"
                               Icon="{ui:SymbolIcon FolderOpen16}"
                               Command="{Binding BrowseMapFolderCommand}"
                               Margin="0,0,8,0"/>
                    <ui:Button Grid.Column="2"
                               Content="使用默认"
                               Command="{Binding UseDefaultMapFolderCommand}"/>
                </Grid>

                <TextBlock Grid.Row="2"
                           Text="留空时使用游戏默认的地图目录。"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,16"/>

                <ui:ToggleSwitch Grid.Row="3"
                                 Content="隐藏所有官方地图"
                                 IsChecked="{Binding HideBuiltInMaps}"/>
            </Grid>
        </Border>

        <WrapPanel Grid.Row="3" Margin="5,0,5,8" HorizontalAlignment="Right">
            <ui:Button Content="保存配置"
                       Icon="{ui:SymbolIcon Save20}"
                       Command="{Binding SaveSettingsCommand}"/>
        </WrapPanel>

        <TextBlock Grid.Row="4"
                   Margin="5,0,5,4"
                   Text="{Binding StatusText}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap"/>
    </Grid>
</ui:FluentWindow>
