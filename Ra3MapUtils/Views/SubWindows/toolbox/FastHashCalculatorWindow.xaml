<ui:FluentWindow x:Class="Ra3MapUtils.Views.SubWindows.toolbox.FastHashCalculatorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:Ra3MapUtils.ViewModels.toolbox"
                 d:DataContext="{d:DesignInstance Type=vm:FastHashCalculatorWindowViewModel, IsDesignTimeCreatable=True}"
                 d:DesignHeight="620"
                 d:DesignWidth="980"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 mc:Ignorable="d"
                 Title="FastHash计算器"
                 Height="620"
                 Width="980"
                 MinHeight="480"
                 MinWidth="760"
                 ResizeMode="CanResizeWithGrip"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStyle="SingleBorderWindow"
                 Topmost="{Binding IsTopmost}">

    <Grid Margin="10,0,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ui:ToggleSwitch Grid.Column="0" Margin="0,6,12,0" Content="置顶" IsChecked="{Binding IsTopmost}"/>
            <ui:TitleBar Grid.Column="1" Title="FastHash计算器" ShowMaximize="True" ShowMinimize="True" ShowClose="True"/>
        </Grid>

        <Grid Grid.Row="1" Margin="5,4,5,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="0"
                      Content="不区分大小写"
                      IsChecked="{Binding IsCaseInsensitive, Mode=TwoWay}"
                      VerticalAlignment="Center"
                      Margin="0,0,14,0"/>
            <ui:ToggleSwitch Grid.Column="1"
                             MinWidth="110"
                             OnContent="十六进制"
                             OffContent="十进制"
                             IsChecked="{Binding IsHexOutput, Mode=TwoWay}"
                             VerticalAlignment="Center"
                             Margin="0,0,14,0"/>
            <TextBlock Grid.Column="2"
                       Text="每行输出一个 FastHash"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <ui:Button Grid.Column="3"
                       Content="复制输出"
                       Icon="{ui:SymbolIcon Copy20}"
                       Command="{Binding CopyOutputCommand}"/>
        </Grid>

        <Grid Grid.Row="2" Margin="5,0,5,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="输入文本" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox Grid.Row="1"
                         Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Background="{DynamicResource CardStrokeColorDefaultBrush}"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="FastHash结果" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox Grid.Row="1"
                         Text="{Binding OutputText, Mode=OneWay}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
