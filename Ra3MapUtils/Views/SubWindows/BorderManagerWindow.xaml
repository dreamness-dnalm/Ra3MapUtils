<ui:FluentWindow x:Class="Ra3MapUtils.Views.SubWindows.BorderManagerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:local="clr-namespace:Ra3MapUtils.Views"
                 xmlns:vm="clr-namespace:Ra3MapUtils.ViewModels"
                 d:DataContext="{d:DesignInstance Type=vm:BorderManagerWindowViewModel, IsDesignTimeCreatable=True}"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 d:DesignHeight="1650"
                 d:DesignWidth="1000"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
                 xmlns:converters="clr-namespace:Ra3MapUtils.Utils.XamlConverters"
                 xmlns:borderConverters="clr-namespace:Ra3MapUtils.Utils.XamlConverters.MapBorder"
                 xmlns:validationRules="clr-namespace:Ra3MapUtils.Utils.XamlValidationRules"
                 xmlns:controls="clr-namespace:Ra3MapUtils.Services.Controls"
                 xmlns:models="clr-namespace:Ra3MapUtils.Models"
                 mc:Ignorable="d"
                 Title="{Binding WindowTitle}" Height="600" Width="800" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStyle="SingleBorderWindow"
                 >
    <ui:FluentWindow.Resources>
        <!-- <converters:BooleanToOppositeVisibilityConverter x:Key="BooleanToOppositeVisibilityConverter"/> -->
        <borderConverters:IndexToDisplayNameConverter x:Key="IndexToDisplayNameConverter"/>
        <borderConverters:IndexToDisplayColorConverter x:Key="IndexToDisplayColorConverter"/>
    </ui:FluentWindow.Resources>
    
    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger EventName="Closed">
            <behaviors:InvokeCommandAction Command="{Binding ClosedCommand}" PassEventArgsToCommand="False"/>
        </behaviors:EventTrigger>
        <!-- <behaviors:EventTrigger EventName="Initialized"> -->
        <!--     <behaviors:InvokeCommandAction Command="{Binding InitializeCommand}" PassEventArgsToCommand="False"/> -->
        <!-- </behaviors:EventTrigger> -->
    </behaviors:Interaction.Triggers>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <ui:TitleBar Grid.Row="0" Grid.ColumnSpan="3" Title="{Binding WindowTitle}" ShowMaximize="False">
            
        </ui:TitleBar>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Vertical" Margin="5, 0, 5, 5">
            <!-- <ui:HyperlinkButton Content="使用文档及常见错误" NavigateUri="https://www.yuque.com/muzeqaq/ra3mapwiki/ofa6ufyd9pmwwgnm" Icon="{ui:SymbolIcon Document20}"/> -->
            <ui:InfoBar Message="现已经解决大部分因包含汉字而发生的文件损坏异常, 但是仍然建议先备份地图." IsOpen="True"  /> 
        </StackPanel>
        
        <Grid Grid.Row="2" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
        
    
            <Menu Grid.Row="0">
                <ui:MenuItem 
                    ToolTip="刷新"
                    Icon="{ui:SymbolIcon ArrowSync20}"
                    Command="{Binding ReloadBoardsCommand}"
                    />
                
                <ui:MenuItem 
                    ToolTip="向上移动"
                    Icon="{ui:SymbolIcon ArrowUp20}"
                    Command="{Binding UpPositionBorderCommand}"
                />
                
                <ui:MenuItem 
                    ToolTip="向下移动"
                    Icon="{ui:SymbolIcon ArrowDown20}"
                    Command="{Binding DownPositionBorderCommand}"
                />
                
                <ui:MenuItem 
                    ToolTip="新增"
                    Icon="{ui:SymbolIcon Add20}"
                    Command="{Binding AddBorderCommand}"
                />
                
                <ui:MenuItem 
                    ToolTip="删除"
                    Icon="{ui:SymbolIcon Delete20}"
                    Command="{Binding DeleteBorderCommand}"
                />
                
                
                <ui:MenuItem 
                    ToolTip="应用"
                    Icon="{ui:SymbolIcon Checkmark20}"
                    Command="{Binding ApplyChangesCommand}"
                />
                
            </Menu>
            
            <ListView x:Name="BorderListView" Grid.Row="1" ItemsSource="{Binding BorderModels}" SelectedItem="{Binding SelectedBorderModel}">
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:MapBorderModel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Row="0" Text="{Binding 
                                            Converter={StaticResource IndexToDisplayNameConverter}, ConverterParameter={x:Reference BorderListView}}" 
                                       Foreground="{Binding 
                                            Converter={StaticResource IndexToDisplayColorConverter}, ConverterParameter={x:Reference BorderListView}}" />
                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                <TextBlock Text="("/>
                                <TextBlock Text="{Binding X1}"/>
                                <TextBlock Text=","/>
                                <TextBlock Text="{Binding Y1}"/>
                                <TextBlock Text=") - ("/>
                                <TextBlock Text="{Binding X2}"/>
                                <TextBlock Text=","/>
                                <TextBlock Text="{Binding Y2}"/>
                                <TextBlock Text=")"/>
                            </StackPanel>
                            
                            
                        </Grid>
                        
                    </DataTemplate>
                </ListView.ItemTemplate>
                
            </ListView>
            
        </Grid>
        
        
        <Separator Grid.Row="2" Grid.Column="1" Width="5" FontWeight="Heavy"/>
        
        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Vertical" Margin="10, 30, 10, 10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="坐标范围: "/>
                <TextBlock Text="("/>
                <TextBlock Text="{Binding MinX}" Margin="0, 0, 5, 0"/>
                <TextBlock Text=","/>
                <TextBlock Text="{Binding MinY}" Margin="0, 0, 5, 0"/>
                <TextBlock Text=") - ("/>
                <TextBlock Text="{Binding MaxX}" Margin="0, 0, 5, 0"/>
                <TextBlock Text=","/>
                <TextBlock Text="{Binding MaxY}" Margin="0, 0, 5, 0"/>
                <TextBlock Text=")"/>
            </StackPanel>
            <TextBlock Text="右上角坐标应大于左下角坐标" Margin="0, 10, 0, 0"/>
            
            <Separator Margin="0, 10, 0, 10"/>
            <TextBlock Text="边界左下角坐标" FontWeight="Bold" Margin="0, 0, 0, 5"/>
            <StackPanel Orientation="Horizontal" Margin="0, 0, 0, 0">
                <TextBlock Text="X: " VerticalAlignment="Center"  Margin="10, 5, 10, 0" FontWeight="Medium"/>
                <ui:NumberBox Width="150"  Margin="10, 5, 10, 0" Value="{Binding SelectedBorderModel.X1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0, 5, 0, 0">
                <TextBlock Text="Y: " VerticalAlignment="Center"  Margin="10, 5, 10, 0" FontWeight="Medium"/>
                <ui:NumberBox Width="150"  Margin="10, 5, 10, 0" Value="{Binding SelectedBorderModel.Y1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <Separator Margin="0, 10, 0, 10"/>
            <TextBlock Text="边界右上角坐标" FontWeight="Bold" Margin="0, 0, 0, 5"/>
            <StackPanel Orientation="Horizontal" Margin="0, 0, 0, 0">
                <TextBlock Text="X: " VerticalAlignment="Center"  Margin="10, 5, 10, 0" FontWeight="Medium"/>
                <ui:NumberBox Width="150"  Margin="10, 5, 10, 0" Value="{Binding SelectedBorderModel.X2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0, 5, 0, 0">
                <TextBlock Text="Y: " VerticalAlignment="Center"  Margin="10, 5, 10, 0" FontWeight="Medium"/>
                <ui:NumberBox Width="150"  Margin="10, 5, 10, 0" Value="{Binding SelectedBorderModel.Y2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </StackPanel>
        
    </Grid>
</ui:FluentWindow>
