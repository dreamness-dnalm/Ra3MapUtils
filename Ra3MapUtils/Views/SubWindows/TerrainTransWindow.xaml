<ui:FluentWindow x:Class="Ra3MapUtils.Views.TerrainTransWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:local="clr-namespace:Ra3MapUtils.Views"
                 xmlns:vm="clr-namespace:Ra3MapUtils.ViewModels"
                 d:DataContext="{d:DesignInstance Type=vm:TerrainTransWindowViewModel, IsDesignTimeCreatable=True}"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:hc="https://handyorg.github.io/handycontrol"
                 d:DesignHeight="1650"
                 d:DesignWidth="1000"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
                 xmlns:converters="clr-namespace:Ra3MapUtils.Utils.XamlConverters"
                 xmlns:validationRules="clr-namespace:Ra3MapUtils.Utils.XamlValidationRules"
                 xmlns:controls="clr-namespace:Ra3MapUtils.Services.Controls"
                 xmlns:models="clr-namespace:Ra3MapUtils.Models"
                 mc:Ignorable="d"
                 Title="{Binding WindowTitle}" Height="495" Width="800" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStyle="SingleBorderWindow"
                 >
    
    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger EventName="Closed">
            <behaviors:InvokeCommandAction Command="{Binding ClosedCommand}" PassEventArgsToCommand="False"/>
        </behaviors:EventTrigger>
        <!-- <behaviors:EventTrigger EventName="Initialized"> -->
        <!--     <behaviors:InvokeCommandAction Command="{Binding InitializeCommand}" PassEventArgsToCommand="False"/> -->
        <!-- </behaviors:EventTrigger> -->
    </behaviors:Interaction.Triggers>
    
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        
        <ui:TitleBar Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Title="{Binding WindowTitle}" ShowMaximize="False"/>
        
        <Grid  Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Row="0" Grid.Column="0" 
                    BorderThickness="1,1,1,0" BorderBrush="LightGray" CornerRadius="5" Padding="10" 
                    Margin="5, 5, 5, 5" Background="White">
                <StackPanel Orientation="Vertical">
                    <ui:TextBlock Text="操作" FontWeight="Heavy" Margin="5, 0, 0, 5"/>
                    <ui:Button Content="撤销" Icon="{ui:SymbolIcon ArrowUndo20}" Margin="0, 0, 10, 0" Command="{Binding UndoCommand}"/>
                    <ui:Button Content="重做" Icon="{ui:SymbolIcon ArrowRedo20}" Command="{Binding RedoCommand }"/>
                    <ui:Button Appearance="Primary" Content="生成地形" Icon="{ui:SymbolIcon Checkmark20}"  HorizontalAlignment="Left" Command="{Binding GenerateMapCommand}"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Row="0" Grid.Column="1" 
                    BorderThickness="1,1,1,0" BorderBrush="LightGray" CornerRadius="5" Padding="10" Margin="0, 5, 5, 5"  Background="White">
                <StackPanel Orientation="Vertical">
                    <ui:TextBlock Text="信息" FontWeight="Heavy" Margin="5, 0, 0, 5"/>
                        <StackPanel Orientation="Horizontal" Margin="5, 0, 0, 5">
                            <ui:TextBlock Text="尺寸 " VerticalAlignment="Center"/>
                            <ui:TextBlock Text="{Binding InfoSize}" VerticalAlignment="Center"/>
                        </StackPanel>
                    
            
                </StackPanel>
            </Border>
            
            
            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="1,1,1,0" BorderBrush="LightGray" CornerRadius="5" Padding="10" Margin="5, 5, 5, 5"  Background="White">
                <StackPanel Orientation="Vertical">
                    <ui:TextBlock Text="预览" FontWeight="Heavy" Margin="5, 0, 0, 5"/>
                    
                    <Image MaxWidth="280" MaxHeight="280" HorizontalAlignment="Center" Source="{Binding MapPreviewImage}"/>
                </StackPanel>
            </Border>
        </Grid> 
        
        <Separator Grid.Row="1" Grid.Column="1"/>
        
        <ScrollViewer Grid.Row="1" Grid.Column="2" >
        
        <hc:WaterfallPanel  Margin="5, 0, 5, 5" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
            <!-- <Border BorderThickness="1,1,1,0" BorderBrush="LightGray" CornerRadius="5" Padding="10" Margin="0, 5, 5, 5"  Background="White"> -->
            <!--     <StackPanel Orientation="Vertical"> -->
            <!--         <ui:TextBlock Text="预览" FontWeight="Heavy" Margin="5, 0, 0, 5"/> -->
            <!--     </StackPanel> -->
            <!-- </Border> -->
            
            <Border BorderThickness="1,1,1,0" BorderBrush="LightGray" CornerRadius="5" Padding="10" Margin="0, 5, 5, 5"  Background="White">
                <StackPanel Orientation="Vertical">
                    <ui:TextBlock Text="裁剪与拓展" FontWeight="Heavy" Margin="5, 0, 0, 5"/>
                    <StackPanel Orientation="Vertical" Margin="10,0,5,5">
                        <ui:TextBlock Text="新地图尺寸" FontWeight="Light" Margin="0, 0, 0, 5"/>
                        <StackPanel Orientation="Horizontal" Margin="0, 0, 0, 5">
                            <ui:TextBlock Text="W 宽度: " VerticalAlignment="Center"/>
                            <ui:TextBox Text="{Binding ResizeNewWidth}" VerticalAlignment="Center" MinWidth="100"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0, 0, 0, 5">
                            <ui:TextBlock Text="H 高度: " VerticalAlignment="Center"/>
                            <ui:TextBox Text="{Binding ResizeNewHeight}" VerticalAlignment="Center" MinWidth="100"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <StackPanel Orientation="Vertical" Margin="10,0,5,5">
                        <ui:TextBlock Text="新地图原点(相对于原地图)" FontWeight="Light" Margin="0, 0, 0, 5"/>
                        <StackPanel Orientation="Horizontal" Margin="0, 0, 0, 5">
                            <ui:TextBlock Text="Y: " VerticalAlignment="Center"/>
                            <ui:TextBox Text="{Binding ResizeNewPositionX}" VerticalAlignment="Center" MinWidth="100"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0, 0, 0, 5">
                            <ui:TextBlock Text="X: " VerticalAlignment="Center"/>
                            <ui:TextBox Text="{Binding ResizeNewPositionY}" VerticalAlignment="Center" MinWidth="100"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <StackPanel Orientation="Vertical" Margin="10,0,5,5">
                        <ui:TextBlock Text="默认纹理" FontWeight="Light" Margin="0, 0, 0, 5"/>
                        <ui:TextBox Text="{Binding ResizeDefaultTexture}" VerticalAlignment="Center" MinWidth="100"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Vertical" Margin="10,0,5,5">
                        <ui:TextBlock Text="默认高度" FontWeight="Light" Margin="0, 0, 0, 5"/>
                        <ui:NumberBox Text="{Binding ResizeDefaultHeight}" VerticalAlignment="Center" MinWidth="100"/>
                    </StackPanel>
                    
                    <ui:Button Content="应用" Command="{Binding ResizeCommand}" Margin="10, 5, 0, 0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
            
            <Border BorderThickness="1,1,1,0" BorderBrush="LightGray" CornerRadius="5" Padding="10" Margin="0, 5, 5, 5"  Background="White">
                <StackPanel Orientation="Vertical">
                    <ui:TextBlock Text="旋转" FontWeight="Heavy" Margin="5, 0, 0, 5"/>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5, 5, 5, 0">
                        <ui:Button Icon="{ui:SymbolIcon ArrowRotateCounterclockwise20}" Content="逆时针90°" Command="{Binding RotateClockwiseCommand}" CommandParameter="270" Margin="0, 0, 0, 10"/>
                        <ui:Button Icon="{ui:SymbolIcon ArrowBidirectionalUpDown20}" Content="180°" Command="{Binding RotateClockwiseCommand}" CommandParameter="180" Margin="0, 0, 0, 10"/>
                        <ui:Button Icon="{ui:SymbolIcon ArrowRotateClockwise20}" Content="顺时针90°" Command="{Binding RotateClockwiseCommand}" CommandParameter="90" Margin="0, 0, 0, 10"/>
                    </StackPanel>
                </StackPanel>
                
            </Border>
            
            <Border BorderThickness="1,1,1,0" BorderBrush="LightGray" CornerRadius="5" Padding="10" Margin="0, 5, 5, 5"  Background="White">
                <StackPanel Orientation="Vertical">
                    <ui:TextBlock Text="旋转" FontWeight="Heavy" Margin="5, 0, 0, 5"/>
                    <StackPanel Orientation="Vertical" Margin="10,0,5,5">
                        <ui:TextBlock Text="对称类型" FontWeight="Light" Margin="0, 0, 0, 5"/>
                        <ComboBox ItemsSource="{Binding SymmetryDivideTypes}"
                                  SelectedIndex="0" SelectedItem="{Binding SelectedSymmetryDivideType}"
                                  MaxWidth="130"
                        >
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding Source}" MaxHeight="128" IsEnabled="{Binding Enabled}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    
                    <StackPanel Orientation="Vertical" Margin="10,0,5,5">
                        <ui:TextBlock Text="模板区域" FontWeight="Light" Margin="0, 0, 0, 5"/>
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBlock Text="{Binding TemplateAreaId}" Margin="0, 0, 5, 0"/>
                            <Slider Minimum="1" Maximum="{Binding SelectedSymmetryDivideType.AreaCnt}"
                                    Value="{Binding TemplateAreaId}"
                                    IsSnapToTickEnabled="True"
                            />
                            </StackPanel>
                        
                    </StackPanel>
                    
                    <ui:Button Content="应用" Command="{Binding SymmetryCommand}" Margin="0, 5, 0, 0"/> 
                    
                </StackPanel>
            </Border>
            
        </hc:WaterfallPanel>
        </ScrollViewer>
        
    </Grid>
        
